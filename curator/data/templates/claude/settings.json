      "Bash(curator rebuild *)",
      "Bash(curator approve *)",
      "Bash(curator reject *)",
      "Bash(curator resolve *)",
      "Bash(curator release *)",
      "Bash(curator discard *)",
      "Bash(curator merge *)",
      "Bash(curator link *)",
      "Bash(curator separate *)",
      "Bash(curator rename *)",
      "Bash(curator alias *)",
      "Bash(curator refile *)",
      "Bash(curator forget *)",
      "Bash(curator supersede-source *)",
      "Bash(curator eval *)",
      "Bash(curator backup *)",
      "Bash(curator restore *)",
      "Bash(curator migrate *)",
      "Bash(curator render *)",
      "Bash(curator init *)"
    ],
    "deny": [
      "Edit(/raw/**)",
