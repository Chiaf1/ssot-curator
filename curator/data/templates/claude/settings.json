{
  "permissions": {
    "allow": [
      "Bash(curator --version)",
      "Bash(curator --help)",
      "Bash(curator status *)",
      "Bash(curator search *)",
      "Bash(curator review *)",
      "Bash(curator conflicts *)",
      "Bash(curator quarantine *)",
      "Bash(curator revisions *)",
